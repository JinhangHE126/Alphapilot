# Copy to alphapilot/.env and fill in values (do not commit .env)
#
#   cp alphapilot/.env.example alphapilot/.env

# Required — multi-agent LLM routing (config/llm.py)
DEEPSEEK_API_KEY=

# Required for API / Web UI — use a random string ≥32 chars in production
JWT_SECRET=replace_with_a_random_secret_at_least_32_chars

# Optional — Gemini fallback / embedding
GOOGLE_API_KEY=

# Optional — data providers (defaults work for demo)
# ENABLED_DATA_PROVIDERS=yfinance,sec_edgar,akshare,eastmoney
