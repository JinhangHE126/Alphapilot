# FastAPI
JWT_SECRET=replace_with_strong_secret
ALLOWED_ORIGINS=https://your-domain.com

# Optional model/provider settings
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional proxy settings
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1

# --- Multi-source data providers ---
# Comma-separated list of enabled providers. Default: yfinance,sec_edgar
ENABLED_DATA_PROVIDERS=yfinance,sec_edgar,polygon,tiingo,finnhub
tushare
# Provider priority: higher number = preferred. Format: name:priority,name:priority
PROVIDER_PRIORITY=sec_edgar:100,polygon:80,tiingo:75,finnhub:70,yfinance:40
# Alpha Vantage API Key (free tier: 25 calls/day, optional smoke-test only)
ALPHA_VANTAGE_API_KEY=
# Polygon API Key (P2 stage, leave empty to auto-disable)
POLYGON_API_KEY=
# Tiingo API Key (P2 stage, leave empty to auto-disable)
TIINGO_API_KEY=
# Finnhub API Key (Phase 3, US fundamentals + news, leave empty to auto-disable)
FINNHUB_API_KEY=
# Tushare API Key (Phase 3, CN market primary, leave empty to auto-disable)
TUSHARE_API_KEY=
