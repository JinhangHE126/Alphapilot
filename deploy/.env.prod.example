# FastAPI
JWT_SECRET=replace_with_strong_secret
ALLOWED_ORIGINS=https://your-domain.com

# Optional model/provider settings
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional proxy settings
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1

# --- Multi-source data providers ---
# Comma-separated list of enabled providers. Default: yfinance,sec_edgar
ENABLED_DATA_PROVIDERS=yfinance,sec_edgar
# Provider priority: higher number = preferred. Format: name:priority,name:priority
PROVIDER_PRIORITY=sec_edgar:100,yfinance:40
# Alpha Vantage API Key (free tier: 25 calls/day, optional smoke-test only)
ALPHA_VANTAGE_API_KEY=
# Polygon API Key (P2 stage, leave empty for now)
# POLYGON_API_KEY=
# Tiingo API Key (P2 stage, leave empty for now)
# TIINGO_API_KEY=
